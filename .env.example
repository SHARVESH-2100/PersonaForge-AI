# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------- MongoDB ---
# Optional. If MongoDB is unreachable the API falls back to backend/.localdb/
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=personaforge_ai

# ------------------------------------------------------------ Gemini AI key ---
# REQUIRED for the AI features. CREATE YOUR OWN KEY - none is bundled with this
# repository, and keys are per-user (never reuse or commit someone else's).
#
#   1. Open https://aistudio.google.com/app/apikey
#   2. Sign in with your Google account
#   3. Click "Create API key" and copy the value
#   4. Paste it below, then save this file as .env
#
# The free tier is enough for demos and development.
GEMINI_API_KEY=PASTE_YOUR_OWN_API_KEY_HERE

# -------------------------------------------------------------------- Misc ---
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
